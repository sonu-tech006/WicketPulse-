# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/wicketpulse?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=wicketpulse_jwt_secret_dev_key_super_secure_923847
COOKIE_SECRET=wicketpulse_cookie_secret_dev_key_192837465

# Cricket Data Provider: Cricbuzz via RapidAPI
CRICKET_DATA_PROVIDER=cricbuzz
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com
POLLING_INTERVAL_SECONDS=10

# News Integration (NewsAPI or Cricket News Provider)
NEWS_API_KEY=
NEWS_DATA_BASE_URL=https://newsapi.org/v2

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
